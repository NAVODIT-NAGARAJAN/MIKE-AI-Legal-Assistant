# LegalEase AI - Environment Variables Template
# ==============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# ---- Application Settings ----
APP_NAME=LegalEase AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ---- API Settings ----
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ---- Database - PostgreSQL ----
DATABASE_URL=postgresql://legalease_user:your_password@localhost:5432/legalease_db
DATABASE_ECHO=false

# ---- Authentication - JWT ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_key_here_replace_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Google Gemini API ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1

# ---- ChromaDB (Vector Database) ----
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=legalease_knowledge

# ---- Embeddings (local sentence-transformers model) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/legalease.log

# ---- Legal Data ----
LEGAL_DATA_PATH=./legal_data
CHUNK_SIZE=500
CHUNK_OVERLAP=50
